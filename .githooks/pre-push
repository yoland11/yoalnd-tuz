#!/bin/sh
remote_name="$1"
remote_url="$2"
diff_base=""

while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_sha" in
    ""|0000000000000000000000000000000000000000) ;;
    *) diff_base="$remote_sha" ;;
  esac
done

if [ -z "$diff_base" ]; then
  diff_base="$(git merge-base HEAD "refs/remotes/$remote_name/main" 2>/dev/null || true)"
fi
if [ -z "$diff_base" ]; then
  diff_base="$(git merge-base HEAD "refs/remotes/$remote_name/master" 2>/dev/null || true)"
fi
if [ -z "$diff_base" ]; then
  diff_base="$(git rev-parse --verify HEAD^ 2>/dev/null || true)"
fi

if [ -n "$diff_base" ]; then
  AJN_DIFF_BASE="$diff_base" pnpm run verify:critical
else
  pnpm run verify:critical
fi
status=$?

if [ "$status" -ne 0 ]; then
  echo "AJN PUSH BLOCKED — Critical regression detected."
  echo "Remote: $remote_name $remote_url"
  exit "$status"
fi

echo "AJN SAFETY CHECK PASSED — Push allowed."
exit 0
