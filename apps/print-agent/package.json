{
  "name": "@ajn/print-agent",
  "version": "1.0.2",
  "description": "AJN ERP Windows remote thermal print agent",
  "author": "AJN",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm run typecheck && electron-builder --dir",
    "dist:win": "pnpm run typecheck && electron-builder --win nsis portable --x64"
  },
  "dependencies": {
    "@workspace/print-template": "workspace:*",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "39.8.5",
    "electron-builder": "26.15.3",
    "typescript": "~5.9.2",
    "@types/node": "^25.3.3",
    "@types/qrcode": "^1.5.6"
  }
}
