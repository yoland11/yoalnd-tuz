# Core runtime
NODE_ENV=development
AJN_ENV=development
LOG_LEVEL=info

# Next.js fullstack runtime
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres
# Integration tests only. Never set this to the production connection string.
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/ajn_test
ALLOW_TEST_WRITES=false
DB_POOL_MAX=5
RATE_LIMIT_BACKEND=memory

SESSION_SECRET=replace-with-a-long-random-session-secret
AUTH_SECRET=replace-with-a-long-random-auth-secret
CRON_SECRET=replace-with-a-long-random-cron-secret
# Set to true only when x-forwarded-for is injected by a trusted reverse proxy.
TRUST_PROXY=false

APP_BASE_URL=https://alijan-koshat.vercel.app
PUBLIC_BASE_URL=https://alijan-koshat.vercel.app

# Supabase Storage for optimized uploaded media
SUPABASE_URL=https://lmchfjycehhwdqnprhxn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=ajn-assets
# Must be a private Supabase bucket; customer photos are served only through AJN authorization.
AJN_CUSTOMER_PRIVATE_BUCKET=ajn-customer-private
# Private research documents; may point to the same private bucket as customer photos.
AJN_RESEARCH_PRIVATE_BUCKET=ajn-customer-private
# Private scanned identity/contract documents; may reuse the same private bucket.
AJN_DOCUMENT_PRIVATE_BUCKET=ajn-customer-private

# Base path
BASE_PATH=/

# First admin seed
# One-time only: enable solely on a new database with no administrator record.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-production
ADMIN_FULL_NAME="المدير الرئيسي"

# WhatsApp providers
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=

# Telegram notifications (server-side only)
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-your-telegram-chat-id

WASSENGER_API_KEY=
WASSENGER_DEVICE=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

META_WA_PHONE_ID=
META_WA_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ترجمة المحتوى التلقائية (من السيرفر فقط — لا يُكشف المفتاح للواجهة)
# المزوّد: openai | google | libretranslate
AUTO_TRANSLATE_PROVIDER=openai
# مزوّد OpenAI
OPENAI_API_KEY=
OPENAI_TRANSLATE_MODEL=gpt-4o-mini
# مزوّد Google Cloud Translation
GOOGLE_TRANSLATE_API_KEY=
# مزوّد LibreTranslate (self-hosted أو عام)
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
